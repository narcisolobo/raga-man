---
import '@fontsource/old-standard-tt/400.css';
import '@fontsource/old-standard-tt/700.css';
import '@fontsource-variable/libre-franklin/index.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  name: string;
  subtitle: string;
  themeStorageKey: string;
}
const { title, description, name, subtitle, themeStorageKey } = Astro.props;
// The name links home from every other page; on home itself a self-link would do nothing.
// The route pattern, not the URL: with build.format 'file' the home URL is /index.html.
const isHome = Astro.routePattern === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e3e5e2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script define:vars={{ themeStorageKey }}>
      // Runs before first paint so a saved theme never flashes the other one.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem(themeStorageKey);
          if (saved === 'light' || saved === 'dark') root.setAttribute('data-theme', saved);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="mast">
        <div class="mast-row">
          <p class="mast-name">{isHome ? name : <a href="/">{name}</a>}</p>
          <button id="theme-toggle" data-storage-key={themeStorageKey} class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </div>
        <p class="mast-sub">{subtitle}</p>
      </header>

      <slot />
      <slot name="footer" />
    </div>

    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
