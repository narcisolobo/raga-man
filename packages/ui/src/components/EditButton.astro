---
/* An icon-only edit button drawn as a pencil. `label` is its accessible name,
   since the button has no visible text. Other attributes pass through. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'button'>, 'aria-label' | 'type'> {
  label: string;
}
const { label, class: className, ...attrs } = Astro.props;
---
<button class:list={['icon-button', className]} type="button" aria-label={label} {...attrs}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 20l1.2-4.4L16.6 4.2a2 2 0 0 1 2.8 0l.4.4a2 2 0 0 1 0 2.8L8.4 18.8z" />
    <path d="M14.5 6.3l3.2 3.2" />
  </svg>
</button>
