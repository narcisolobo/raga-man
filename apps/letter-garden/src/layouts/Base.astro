---
import Shell from '@solver-suite/ui/layout';
import '@solver-suite/ui/squares.css';
import '../styles/letter-garden.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<Shell
  {title}
  description="Find words using your seven puzzle letters."
  name="letter-garden"
  subtitle="The seven-letter solver"
  themeStorageKey="letter-garden-theme"
>
  <slot />
  <footer class="foot" slot="footer">
    <p>
      Words of four letters or more. No names, no possessives. Your game may accept words not listed here, or reject
      some that are.
    </p>
    <p>Word list: <a href="https://packages.debian.org/stable/wamerican">Debian wamerican (SCOWL)</a>.</p>
  </footer>
</Shell>
