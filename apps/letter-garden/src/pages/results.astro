---
import PuzzleForm from '../components/PuzzleForm.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Results | letter-garden">
  <main class="garden">
    <h1 id="results-heading" class="sr-only">Results</h1>
    <div id="puzzle-summary" hidden>
      <div class="field-head"><p class="label">Your letters</p></div>
      <div id="summary-squares" class="squares has-center" aria-hidden="true"></div>
      <p id="summary-required" class="sr-only"></p>
      <button class="btn-secondary" id="edit-puzzle" type="button">Edit letters</button>
    </div>
    <div id="edit-puzzle-panel" hidden>
      <PuzzleForm id="edit-form" cancel />
    </div>
    <div id="invalid-puzzle" hidden>
      <PuzzleForm id="repair-form" />
    </div>
    <p id="results-status" role="status"></p>
    <button class="btn-secondary" id="retry-load" type="button" hidden>Retry</button>
    <div id="results-content"></div>
    <p><a href="/">New search</a></p>
    <noscript>Turn on JavaScript to find words.</noscript>
  </main>
</Base>
<script>
  import { mountResults } from '../scripts/results';

  mountResults();
</script>
