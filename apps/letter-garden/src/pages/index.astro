---
import PuzzleForm from '../components/PuzzleForm.astro';
import Base from '../layouts/Base.astro';
---
<Base title="letter-garden">
  <main class="garden">
    <h1>Find every word hiding in your seven letters.</h1>
    <PuzzleForm id="puzzle-form" />
    <p class="example">No letters handy? Try <a href="/results?letters=acinort&amp;required=c">C + AINORT</a></p>
    <noscript>Turn on JavaScript to find words.</noscript>
  </main>
</Base>
<script>
  import { mountPuzzleForm } from '../scripts/puzzle-form';

  mountPuzzleForm(document.querySelector<HTMLFormElement>('#puzzle-form')!).input.focus();
</script>
