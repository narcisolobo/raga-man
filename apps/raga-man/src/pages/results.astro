---
import EditButton from '@solver-suite/ui/edit-button';
import Base from '../layouts/Base.astro';
import '@solver-suite/ui/results.css';
import '../styles/results.css';
import { MAX_LETTERS } from '../lib/letters';
---
<Base title="Results - raga-man" description="Words hiding in your letters.">
  <main>
    <h1 id="page-title" class="sr-only">Results</h1>
    <p class="back"><a href="/">New search</a></p>

    <section id="letters-block" class="letters">
      <div class="field-head">
        <p class="label">Your letters</p>
        <EditButton id="edit-letters" label="Edit letters" />
      </div>
      <div id="letters-display" class="squares" aria-hidden="true"></div>
    </section>

    <form id="edit-form" method="get" action="/results" hidden>
      <div class="field-head">
        <label for="edit-input">Letters</label>
        <span id="edit-count" class="count" aria-hidden="true">0 / {MAX_LETTERS}</span>
      </div>
      <div class="field">
        <div id="edit-squares" class="squares" aria-hidden="true"></div>
        <input
          id="edit-input"
          name="letters"
          type="text"
          enterkeyhint="go"
          autocomplete="off"
          autocapitalize="characters"
          autocorrect="off"
          spellcheck="false"
          aria-describedby="edit-status"
        />
      </div>
      <p id="edit-status" class="status" role="status"></p>
      <button class="solve" type="submit">Solve</button>
      <button id="edit-cancel" class="btn-secondary" type="button">Cancel</button>
    </form>

    <section id="exact-section" class="exact" aria-live="polite"></section>
    <button id="partials-button" class="btn-secondary" type="button" hidden>Show partial anagrams</button>
    <p id="partials-status" class="sr-only" role="status"></p>
    <section id="partials-section"></section>
  </main>

  <script>
    import '../scripts/results';
  </script>
</Base>
