{
  "name": "solver-suite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter raga-man dev",
    "dev:raga-man": "pnpm --filter raga-man dev",
    "build": "pnpm -r --if-present build",
    "build:raga-man": "pnpm --filter raga-man build",
    "build:data": "pnpm -r --if-present build:data",
    "preview": "pnpm --filter raga-man preview",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "deploy:raga-man": "pnpm --filter raga-man deploy:cf"
  },
  "packageManager": "pnpm@12.18.0"
}
