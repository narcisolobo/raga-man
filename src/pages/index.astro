---
import '@fontsource/old-standard-tt/400.css';
import '@fontsource/old-standard-tt/700.css';
import '@fontsource-variable/libre-franklin';
import { MAX_LETTERS } from '../lib/letters';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e3e5e2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16191a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content="Find every word hiding in your leftover letters." />
    <title>raga-man</title>
    <script is:inline>
      // Runs before first paint so a saved theme never flashes the other one.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('raga-theme');
          if (saved === 'light' || saved === 'dark') root.setAttribute('data-theme', saved);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="mast">
        <div class="mast-row">
          <p class="mast-name">raga-man</p>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </div>
        <p class="mast-sub">The anagram solver</p>
      </header>

      <main>
        <h1>Find every word hiding in your leftover letters.</h1>

        <form id="solve-form" method="get" action="/results">
          <div class="field-head">
            <label for="letters">Letters</label>
            <span id="count" class="count" aria-hidden="true">0 / {MAX_LETTERS}</span>
          </div>
          <div class="field">
            <div id="squares" class="squares" aria-hidden="true">
              <span class="sq is-active"></span><span class="sq"></span><span class="sq"></span><span class="sq"></span><span class="sq"></span><span class="sq"></span><span class="sq"></span><span class="sq"></span>
            </div>
            <input
              id="letters"
              name="letters"
              type="text"
              enterkeyhint="go"
              autofocus
              autocomplete="off"
              autocapitalize="characters"
              autocorrect="off"
              spellcheck="false"
              aria-describedby="hint status"
            />
          </div>
          <p id="hint" class="hint">Spaces, digits and punctuation are ignored. Up to {MAX_LETTERS} letters.</p>
          <p id="status" class="status" role="status"></p>
          <button class="solve" type="submit">Solve</button>
        </form>

        <p class="example">No letters handy? Try <a href="/results?letters=pleats">PLEATS</a></p>
      </main>

      <footer class="foot">
        <p>Words of four letters or more. No names, no possessives.</p>
      </footer>
    </div>

    <style is:global>
      :root {
        --paper: #e3e5e2;
        --cell: #f2f3f1;
        --ink: #121413;
        --muted: #464b48;
        --pencil: #2748a8;
        --mark: #cfd8f0;
        --on-ink: #e3e5e2;
        --display: 'Old Standard TT', 'Times New Roman', serif;
        --sans: 'Libre Franklin Variable', 'Helvetica Neue', Arial, sans-serif;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --paper: #16191a;
          --cell: #1f2324;
          --ink: #e6e9e5;
          --muted: #a9afab;
          --pencil: #9db3f2;
          --mark: #2c3a63;
          --on-ink: #16191a;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --paper: #16191a;
        --cell: #1f2324;
        --ink: #e6e9e5;
        --muted: #a9afab;
        --pencil: #9db3f2;
        --mark: #2c3a63;
        --on-ink: #16191a;
        color-scheme: dark;
      }

      * { box-sizing: border-box; margin: 0; }
      html { -webkit-text-size-adjust: 100%; scrollbar-color: var(--muted) var(--paper); }
      body {
        background: var(--paper);
        color: var(--ink);
        font: 400 1rem/1.5 var(--sans);
        min-height: 100dvh;
      }
      ::selection { background: var(--mark); color: var(--ink); }

      .page {
        max-width: 30rem;
        margin: 0 auto;
        padding: 1.25rem max(1.25rem, env(safe-area-inset-right)) 2rem max(1.25rem, env(safe-area-inset-left));
      }

      /* Masthead: name centred, double rule beneath, toggle at the right. */
      .mast { border-bottom: 4px double var(--ink); padding-bottom: 0.75rem; text-align: center; }
      .mast-row { position: relative; display: flex; justify-content: center; align-items: center; min-height: 2.75rem; }
      .mast-name {
        font: 700 clamp(2.5rem, 13vw, 3.5rem)/1 var(--display);
        letter-spacing: -0.01em;
      }
      .mast-sub {
        margin-top: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .theme-toggle {
        position: absolute;
        right: -0.5rem;
        top: 50%;
        translate: 0 -50%;
        width: 2.75rem;
        height: 2.75rem;
        display: grid;
        place-items: center;
        background: none;
        border: 0;
        border-radius: 50%;
        color: var(--ink);
        cursor: pointer;
      }
      .theme-toggle[hidden] { display: none; }
      .theme-toggle:hover { background: var(--mark); }
      .theme-toggle[aria-pressed='true'] svg { transform: scaleX(-1); }

      h1 {
        margin-top: 2rem;
        font: 700 1.625rem/1.2 var(--display);
        text-wrap: balance;
      }

      /* Field: a row of squares drawn over a real input. */
      .field-head { display: flex; justify-content: space-between; align-items: baseline; margin-top: 1.75rem; }
      label { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
      .count { font-size: 0.8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }

      .field { position: relative; margin-top: 0.5rem; }
      .squares {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        padding: 0 2px 2px 0;
      }
      .sq {
        position: relative;
        aspect-ratio: 1;
        display: grid;
        place-items: center;
        margin: 0 -2px -2px 0;
        background: var(--cell);
        border: 2px solid var(--ink);
        font: 700 clamp(1.5rem, 7vw, 2.125rem)/1 var(--sans);
        text-transform: uppercase;
        font-variation-settings: 'wdth' 100;
      }
      .sq.is-new { animation: pencil-in 160ms var(--ease-out); }
      @keyframes pencil-in {
        from { opacity: 0.2; translate: 0 6px; }
        to { opacity: 1; translate: 0 0; }
      }
      .field:focus-within .sq.is-active {
        z-index: 1;
        background: var(--mark);
        outline: 3px solid var(--pencil);
        outline-offset: -3px;
      }
      .field:focus-within .sq.is-active::after {
        content: '';
        position: absolute;
        left: 7px;
        top: 20%;
        bottom: 20%;
        width: 2px;
        background: var(--pencil);
        animation: blink 1.1s steps(1) infinite;
      }
      /* Caret after the final letter (reached at the 48-letter cap). */
      .field:focus-within .sq.is-active.is-end::after { left: auto; right: 7px; }
      @keyframes blink { 50% { opacity: 0; } }

      .field input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        font: 400 1rem/1 var(--sans);
        text-transform: uppercase;
      }
      .js .field input { color: transparent; caret-color: transparent; cursor: text; }
      .js .field input::selection { background: transparent; }
      .field input:focus { outline: none; }
      html:not(.js) .squares { display: none; }
      html:not(.js) .field input { position: static; height: 4rem; padding: 0 1rem; border: 2px solid var(--ink); background: var(--cell); color: var(--ink); font-size: 1.5rem; }

      .hint { margin-top: 0.875rem; font-size: 0.9375rem; color: var(--muted); text-wrap: balance; }
      .status { min-height: 1.5rem; margin-top: 0.25rem; font-size: 0.9375rem; font-weight: 600; }

      .solve {
        display: block;
        width: 100%;
        height: 4rem;
        margin-top: 0.75rem;
        background: var(--ink);
        color: var(--on-ink);
        border: 0;
        font: 700 1.125rem/1 var(--sans);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .solve:active { translate: 0 1px; }
      @media (hover: hover) { .solve:hover { background: var(--pencil); color: var(--paper); } }

      .solve:focus-visible,
      .theme-toggle:focus-visible,
      .example a:focus-visible {
        outline: 3px solid var(--pencil);
        outline-offset: 3px;
      }

      .example { margin-top: 1.25rem; text-align: center; font-size: 0.9375rem; color: var(--muted); }
      .example a {
        display: inline-block;
        padding: 0.5rem 0.25rem;
        color: var(--pencil);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
      }

      .foot { margin-top: 2.5rem; padding-top: 0.75rem; border-top: 1px solid var(--ink); font-size: 0.8125rem; color: var(--muted); text-wrap: balance; }

      @media (min-width: 40rem) {
        .page { padding-top: 3rem; }
        h1 { font-size: 2rem; }
        .sq { font-size: 2.25rem; }
      }
      /* Forced colours (Windows High Contrast): keep the real input invisible over the squares. */
      @media (forced-colors: active) {
        .js .field input { forced-color-adjust: none; color: transparent; }
        .sq { border-color: CanvasText; }
        .solve { border: 2px solid ButtonText; }
        .field:focus-within .sq.is-active { outline-color: Highlight; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sq.is-new { animation: none; }
        .field:focus-within .sq.is-active::after { animation: none; }
      }
    </style>

    <script>
      import '../scripts/theme';
      import '../scripts/home';
    </script>
  </body>
</html>
